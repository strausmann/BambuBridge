{
  "name": "bambubridge-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "//": "typescript stays below 6.1 (typescript-eslint 8.72.2 requires <6.1.0) and eslint stays on 9 (eslint-plugin-jsx-a11y 6.10.2 supports at most ESLint 9); see the matching ignore rules in .github/dependabot.yml. react-aria-components stays on an exact version: src/shell/overlays/useOpenUntilRevealed.ts relies on how 1.22.1 calls onEnter when it reveals a modal overlay (and cancels the transitions then running), and RevealPopover on shouldSkipAnimation and isEntering of Popover; on every upgrade re-check them and run src/shell/overlays/reveal.test.tsx, e2e/back.spec.ts and harness/popover-reveal.spec.ts.",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/icons.ts",
    "build": "pnpm icons && pnpm i18n:compile && tsc -b && vite build",
    "typecheck": "pnpm i18n:compile && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build-test": "REQUIRE_DIST=1 vitest run src/build.test.ts src/pwa.test.ts src/manifest.test.ts",
    "e2e": "playwright test",
    "e2e:harness": "playwright test -c playwright.harness.config.ts",
    "gen:api": "node scripts/gen-api.ts",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict --typescript"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
