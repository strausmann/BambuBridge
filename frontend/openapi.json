        "type": "apiKey"
      },
      "BambuBridgeKey": {
        "description": "API token (bb_pat_...). The required scope is listed per operation.",
        "in": "header",
        "name": "X-BambuBridge-Key",
        "type": "apiKey"
      }
    }
